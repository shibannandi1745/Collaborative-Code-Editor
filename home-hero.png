@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');
@import "tailwindcss";
@import "tw-animate-css";
@plugin "@tailwindcss/typography";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --font-sans: 'Inter', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));

  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-card-border: hsl(var(--card-border));

  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));
  --color-popover-border: hsl(var(--popover-border));

  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));

  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));

  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));

  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));

  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));

  --color-sidebar: hsl(var(--sidebar));
  --color-sidebar-foreground: hsl(var(--sidebar-foreground));
  --color-sidebar-border: hsl(var(--sidebar-border));
  --color-activity-bar: hsl(var(--activity-bar));
  
  --color-online: hsl(var(--online));
  --color-offline: hsl(var(--offline));
  --color-away: hsl(var(--away));

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  /* LIGHT MODE (Clean, subtle grays like GitHub/VSCode light) */
  --background: 0 0% 100%;
  --foreground: 224 71.4% 4.1%;
  
  --card: 0 0% 100%;
  --card-foreground: 224 71.4% 4.1%;
  --card-border: 220 13% 91%;
  
  --popover: 0 0% 100%;
  --popover-foreground: 224 71.4% 4.1%;
  --popover-border: 220 13% 91%;
  
  --primary: 235 86% 65%; /* Discord Blurple */
  --primary-foreground: 210 40% 98%;
  
  --secondary: 220 14.3% 95.9%;
  --secondary-foreground: 220.9 39.3% 11%;
  
  --muted: 220 14.3% 95.9%;
  --muted-foreground: 220 8.9% 46.1%;
  
  --accent: 220 14.3% 95.9%;
  --accent-foreground: 220.9 39.3% 11%;
  
  --destructive: 0 84.2% 60.2%;
  --destructive-foreground: 210 40% 98%;

  --border: 220 13% 91%;
  --input: 220 13% 91%;
  --ring: 235 86% 65%;

  --sidebar: 210 20% 98%; /* Light gray */
  --sidebar-foreground: 224 71.4% 4.1%;
  --sidebar-border: 220 13% 91%;
  
  --activity-bar: 220 14% 96%;

  --online: 139 47% 48%;
  --offline: 218 11% 65%;
  --away: 38 92% 50%;

  --radius: 0.5rem;
}

.dark {
  /* DARK MODE (Discord + VSCode Hybrid) */
  --background: 223 7% 12%; /* VSCode editor bg #1e1e1e */
  --foreground: 210 40% 98%;
  
  --card: 223 7% 17%; /* Slightly lighter for cards */
  --card-foreground: 210 40% 98%;
  --card-border: 223 7% 10%;
  
  --popover: 223 7% 17%;
  --popover-foreground: 210 40% 98%;
  --popover-border: 223 7% 10%;
  
  --primary: 235 86% 65%; /* Discord Blurple */
  --primary-foreground: 210 40% 98%;
  
  --secondary: 223 7% 24%;
  --secondary-foreground: 210 40% 98%;
  
  --muted: 223 7% 21%;
  --muted-foreground: 215 20.2% 65.1%;
  
  --accent: 223 7% 26%; /* Hover states */
  --accent-foreground: 210 40% 98%;
  
  --destructive: 0 62.8% 30.6%;
  --destructive-foreground: 210 40% 98%;

  --border: 223 7% 15%;
  --input: 223 7% 21%;
  --ring: 235 86% 65%;

  --sidebar: 220 7% 18%; /* Discord sidebar #2b2d31 */
  --sidebar-foreground: 210 40% 98%;
  --sidebar-border: 223 7% 13%;

  --activity-bar: 225 6% 13%; /* Discord left bar #1e1f22 */

  --online: 139 47% 48%;
  --offline: 216 7% 32%;
  --away: 38 92% 50%;
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground antialiased font-sans selection:bg-primary/30 selection:text-primary-foreground;
  }
}

/* Custom Scrollbar for IDE feel */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  @apply bg-muted-foreground/30 border-2 border-solid border-transparent bg-clip-padding rounded-full;
}
::-webkit-scrollbar-thumb:hover {
  @apply bg-muted-foreground/50;
}
